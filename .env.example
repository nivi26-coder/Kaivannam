# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored; never commit real credentials.

# ---------------------------------------------------------------- Supabase
# Supabase dashboard -> Connect (green button) -> Framework -> Next.js,
# or Project Settings -> API Keys.

# Project URL: safe to expose (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...), or the legacy "anon" key.
# Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...), or the legacy "service_role" key.
# SERVER ONLY: bypasses row-level security. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Database password you chose when creating the project. Only the Supabase
# CLI uses it (to apply migrations); the app itself doesn't.
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------ MongoDB (demo)
# Being replaced by Supabase in Phase 1. Leave this commented out: without
# it the current demo runs on built-in mock data.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaivannam?retryWrites=true&w=majority
