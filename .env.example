# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored; never commit real credentials.
#
# No MONGODB_URI? The app runs on built-in mock data instead (in memory,
# reset on restart). Set it and restart the dev server to use Atlas.

# MongoDB Atlas -> your cluster -> Connect -> Drivers.
# Add a database name before the "?" (here: kaivannam).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaivannam?retryWrites=true&w=majority
