# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored; never commit real credentials.

# MongoDB Atlas -> your cluster -> Connect -> Drivers.
# Add a database name before the "?" (here: kaivannam).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kaivannam?retryWrites=true&w=majority
